{
  "name": "jta-server",
  "version": "1.0.0",
  "description": "Jani Trace Analyzer — 本地 Web 分析平台（后端）",
  "type": "module",
  "main": "server.mjs",
  "scripts": {
    "start": "node server.mjs",
    "dev": "node --watch server.mjs",
    "dev:ui": "cd ui && npm run dev",
    "build:ui": "cd ui && npm run build",
    "dev:full": "node --input-type=module --eval \"import{spawn}from'child_process';import{resolve,dirname}from'path';import{fileURLToPath}from'url';const d=dirname(fileURLToPath(import.meta.url));function run(cmd,args,cwd,tag){const c=spawn(cmd,args,{cwd,stdio:'pipe',shell:false});const pre=s=>s.replace(/^/gm,tag);c.stdout.on('data',b=>process.stdout.write(pre(b.toString())));c.stderr.on('data',b=>process.stderr.write(pre(b.toString())));c.on('exit',code=>{console.log(tag+'exited with '+code);process.exit(code??0)});return c;}const be=run('node',['--watch','server.mjs'],d,'[server] ');const fe=run('npm',['run','dev'],resolve(d,'ui'),'[vite]   ');process.on('SIGINT',()=>{be.kill();fe.kill();process.exit(0)});\"",
    "mcp:stdio": "node mcp/jta-mcp-stdio.mjs",
    "mcp:sse": "node mcp/jta-mcp-sse.mjs",
    "mcp:streamable": "node mcp/jta-mcp-streamable.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^12.8.0",
    "cors": "^2.8.6",
    "express": "^4.22.1",
    "multer": "^1.4.5-lts.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "uuid": "^9.0.1",
    "ws": "^8.20.0",
    "zod": "^4.3.6"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
